{
  "expo": {
    "name": "Predicción Mundial",
    "slug": "porra-mundial-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "prediccionmundialapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aidgrande.prediccionmundial",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Necesitamos acceso al micrófono para enviar notas de voz en el chat del grupo.",
        "NSPhotoLibraryUsageDescription": "Necesitamos acceso a tus fotos para compartir imágenes en el chat del grupo.",
        "NSCameraUsageDescription": "Necesitamos acceso a la cámara para tomar fotos y compartirlas en el chat."
      }
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.aidgrande.prediccionmundial",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9ac7786a-47c5-43b8-9029-39ce0843592b"
      }
    },
    "owner": "aidgrande"
  }
}