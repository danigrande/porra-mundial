# ============================================
# AGENTE MUNDIAL — Variables de Entorno
# ============================================
# Copia este archivo como .env y rellena los valores.

# --- Groq (LLM gratuito) ---
# Obtén tu API key gratis en: https://console.groq.com
GROQ_API_KEY=gsk_tu_api_key_aqui

# --- Modelo de Groq ---
# Opciones gratuitas: llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# --- Google Apps Script URL (tu backend existente) ---
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbwUG7NAswIhcLn90C6JkA_Dt-45HBz8Klvmwij2UO0ilh85KUs6tUTz05-wALfTulnN/exec

# --- Mapeo de teléfonos a jugadores ---
# Formato: código de país + número, sin +, sin espacios
# Ejemplo España: 34612345678
PHONE_DANI=34612345678
PHONE_JUDAS=34612345679
PHONE_HARRY=34612345680
PHONE_DANI_GRANDE=34612345681

# --- WhatsApp Group ID (opcional) ---
# Si se define, el bot SOLO responde en este grupo
# Para encontrar el ID, el bot imprime los IDs de grupo cuando recibe mensajes
WHATSAPP_GROUP_ID=

# --- Puerto del servidor (Render lo asigna automáticamente) ---
PORT=3000
